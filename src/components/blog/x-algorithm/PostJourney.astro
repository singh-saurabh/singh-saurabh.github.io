];

// Render
const vp=document.getElementById('pj-viewport');
const dots=document.getElementById('pj-dots');
const label=document.getElementById('pj-label');
let cur=0,oonOn=false;

STEPS.forEach((s,i)=>{
  const sl=document.createElement('div');
  sl.className='pj-slide'+(i===0?' active':'');
  sl.innerHTML=`<div class="pj-num">${s.num}</div><div class="pj-title">${s.title}</div><div class="pj-sub">${s.sub}</div><div>${s.body()}</div>`;
  vp.appendChild(sl);
  const d=document.createElement('button');
  d.className='pj-dot'+(i===0?' active':'');
  d.title=s.title;
  d.onclick=()=>goTo(i);
  dots.appendChild(d);
});

function goTo(n){
  if(n<0||n>=STEPS.length)return;
  cur=n;
  document.querySelectorAll('.pj-slide').forEach((s,i)=>{
    s.classList.remove('active','prev');
    if(i===cur)s.classList.add('active');
    else if(i<cur)s.classList.add('prev');
  });
  document.querySelectorAll('.pj-dot').forEach((d,i)=>d.classList.toggle('active',i===cur));
  label.textContent=STEPS[cur].num+': '+STEPS[cur].title;
  document.getElementById('pj-prev').disabled=cur===0;
  document.getElementById('pj-next').disabled=cur===STEPS.length-1;
  if(cur===7)updAdj();
}
document.getElementById('pj-prev').onclick=()=>goTo(cur-1);
document.getElementById('pj-next').onclick=()=>goTo(cur+1);

// Keyboard (only when pj is in view)
document.addEventListener('keydown',e=>{
  const r=document.getElementById('pj').getBoundingClientRect();
  if(r.top>window.innerHeight||r.bottom<0)return;
  if(e.key==='ArrowRight'){e.preventDefault();goTo(cur+1);}
  if(e.key==='ArrowLeft'){e.preventDefault();goTo(cur-1);}
});

// OON toggle
window.pjToggleOON=function(){
  oonOn=!oonOn;
  const btn=document.getElementById('pj-oon');
  if(btn)btn.classList.toggle('on',oonOn);
  const fx=document.getElementById('pj-oon-fx');
  if(fx)fx.innerHTML=oonOn?'OON discount REMOVED: score * 1.0\nBidirectional boost: reply weight 5.0 + 15.0 = 20.0\n\nNew reply contribution: 20.0 * 0.02 = 0.40 (was 0.10)\nNew score: ~0.63 (nearly 2.5x higher!)':'OON discount applied: score * 0.75';
  updAdj();
};
function updAdj(){
  const el=document.getElementById('pj-adj');
  if(!el)return;
  if(oonOn){
    el.innerHTML='<div class="score-big" style="color:#10B981">0.6312</div><div class="score-c">Raw + reply boost</div><div class="score-c">OON: 1.0x (following)</div><div class="score-c">BiDir: +15.0</div><div class="score-c" style="color:#10B981">~2.5x higher!</div>';
  } else {
    el.innerHTML='<div class="score-big">0.2554</div><div class="score-c">Raw: 0.3405</div><div class="score-c">Diversity: 1.0x</div><div class="score-c" style="color:#EF4444">OON: 0.75x</div><div class="score-c">0.3405 * 0.75 = 0.2554</div>';
  }
}

window.xpt=function(h){h.closest('.xp').classList.toggle('o');};
goTo(0);
})();
</script>
