---
const baseRules = [
  { name: 'Author State (5 rules)', desc: 'Active, not suspended/deactivated/erased' },
  { name: 'Viewer Relationship (3)', desc: 'No blocks, no mutes, no muted retweets' },
  { name: 'Tweet Labels (8)', desc: 'No PDNA, spam, FOSNR, bounce labels' },
  { name: 'Platform Rules (5)', desc: 'Not nullcast, stale, or legally taken down' },
  { name: 'Viewer Age (3)', desc: 'Logged in, stated age, not underage' },
  { name: 'NSFW Interstitials (4)', desc: 'No NSFW/gore labels present' },
];
const oonRules = [
  { name: 'Tweet Label Drops (14)', desc: 'No DMCA, NSFW, spam, malicious URL, do-not-amplify' },
  { name: 'Author Label Drops (12)', desc: 'No NSFW/spam/compromised/impersonation labels' },
];
---

<div class="vf-wrap">
  <div class="vf-section">
    <div class="vf-section-label">Base Rules (28) — all posts</div>
    {baseRules.map(r => (
      <div class="vf-row">
        <span class="vf-icon vf-pass">&#10003;</span>
        <span class="vf-name">{r.name}</span>
        <span class="vf-desc">{r.desc}</span>
      </div>
    ))}
  </div>
  <div class="vf-section">
    <div class="vf-section-label">OON-Only Rules (+26) — stricter for recommendations</div>
    {oonRules.map(r => (
      <div class="vf-row">
        <span class="vf-icon vf-pass">&#10003;</span>
        <span class="vf-name">{r.name}</span>
        <span class="vf-desc">{r.desc}</span>
      </div>
    ))}
  </div>
  <div class="vf-verdict">
    <span class="vf-verdict-label">Verdict:</span>
    <span class="vf-verdict-val">ALLOW</span>
  </div>
</div>

<style>
  .vf-wrap {
    margin: 24px 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .vf-section { padding: 8px 0; }
  .vf-section + .vf-section { border-top: 1px solid var(--border); }
  .vf-section-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    padding: 4px 16px 6px;
  }
  .vf-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 16px;
    font-size: 12px;
  }
  .vf-row:hover { background: var(--tag-bg); }
  .vf-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex: none;
  }
  .vf-pass { background: rgba(16,185,129,0.1); color: #10B981; }
  .vf-name {
    font-family: var(--font-mono);
    font-size: 11px;
    flex: none;
    min-width: 180px;
  }
  .vf-desc {
    font-size: 11px;
    color: var(--text-secondary);
  }
  .vf-verdict {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
  }
  .vf-verdict-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-secondary);
  }
  .vf-verdict-val {
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    color: #10B981;
  }
</style>
